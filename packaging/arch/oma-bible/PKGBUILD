# Maintainer: Eyasu kibru <eyasukibru290@gmail.com>
#
# Builds the Oma Bible desktop app from this clone of the repository and
# installs it as an Arch package:
#
#   git clone https://github.com/Eyasuk/oma-bible.git
#   cd oma-bible/packaging/arch/oma-bible
#   makepkg -si
#
# The oma-bible-tui next door is built the same way, separately. Remove the
# package again with: sudo pacman -R oma-bible
#
# This PKGBUILD is for local builds only and must not be submitted to the
# AUR: it builds the clone it sits in (through $startdir) instead of
# downloading a source listed in source=(). The AUR package is
# packaging/aur/PKGBUILD.

pkgname=oma-bible
pkgver=0.1.2
pkgrel=1
pkgdesc="Quiet, native Bible reader with study tools (desktop app)"
arch=('x86_64' 'aarch64')
url="https://github.com/Eyasuk/oma-bible"
license=('MIT')
# Linked: glibc, libgcc, libxcb, libxkbcommon(-x11). Loaded at run time:
# libwayland-client/-egl (wayland) and libEGL (libglvnd).
depends=('glibc' 'libgcc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libglvnd')
makedepends=('cargo' 'pkgconf')
conflicts=('oma-bible-bin')
# Cargo's release profile already strips and uses thin LTO, so makepkg's
# own LTO flags and an (empty) debug package add nothing.
options=('!lto' '!debug')

# The repository root: this file lives in packaging/arch/oma-bible.
_root="$(realpath "$startdir/../../..")"

pkgver() {
  sed -n 's/^version = "\(.*\)"/\1/p' "$_root/Cargo.toml" | head -n1
}

prepare() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  # Reuse the clone's target directory, so building again (or building the
  # other app) does not start from scratch.
  export CARGO_TARGET_DIR="$_root/target"
  cargo build --frozen --release -p oma-bible-gpui
}

check() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$_root/target"
  cargo test --frozen -p oma-bible-core -p oma-bible-gpui
}

package() {
  cd "$_root"
  install -Dm755 target/release/oma-bible    "$pkgdir/usr/bin/oma-bible"
  install -Dm644 packaging/oma-bible.desktop "$pkgdir/usr/share/applications/oma-bible.desktop"
  install -Dm644 LICENSE                     "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
